digraph mer {
  graph [rankdir=LR, fontname="Arial", fontsize=20, labelloc=t, pad=0.3, dpi=200, nodesep=0.4, ranksep=1.3, splines=true,
         label="Modelo entidad-relación · base de datos del sistema de inferencia (sedati)\n "];
  node [fontname="Arial", fontsize=12];
  edge [arrowhead=crow, arrowtail=tee, dir=both, color="#000000"];
  subgraph cluster_kb { label="Base de conocimiento (3 tablas)"; fontsize=15; style=rounded; color="#3d85c6";
  "hipotesis" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#cfe2f3"><B>hipotesis</B></TD></TR><TR><TD PORT="id_l" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">smallint unsigned</TD><TD PORT="id" ALIGN="RIGHT">PK</TD></TR><TR><TD PORT="codigo_l" ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT">char(6)</TD><TD PORT="codigo" ALIGN="RIGHT">UK</TD></TR><TR><TD PORT="nombre_l" ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">varchar(120)</TD><TD PORT="nombre" ALIGN="RIGHT">UK</TD></TR><TR><TD PORT="dominio_l" ALIGN="LEFT">dominio</TD><TD ALIGN="LEFT">enum('Hardware',…)</TD><TD PORT="dominio" ALIGN="RIGHT"></TD></TR><TR><TD PORT="probabilidad_previa_l" ALIGN="LEFT">probabilidad_previa</TD><TD ALIGN="LEFT">decimal(7,5)</TD><TD PORT="probabilidad_previa" ALIGN="RIGHT"></TD></TR><TR><TD PORT="activo_l" ALIGN="LEFT">activo</TD><TD ALIGN="LEFT">tinyint(1)</TD><TD PORT="activo" ALIGN="RIGHT"></TD></TR></TABLE>>];
  "evidencia" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#cfe2f3"><B>evidencia</B></TD></TR><TR><TD PORT="id_l" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">smallint unsigned</TD><TD PORT="id" ALIGN="RIGHT">PK</TD></TR><TR><TD PORT="codigo_l" ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT">char(5)</TD><TD PORT="codigo" ALIGN="RIGHT">UK</TD></TR><TR><TD PORT="tipo_l" ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT">enum('SINTOMA','PRUEBA')</TD><TD PORT="tipo" ALIGN="RIGHT"></TD></TR><TR><TD PORT="enunciado_l" ALIGN="LEFT">enunciado</TD><TD ALIGN="LEFT">varchar(250)</TD><TD PORT="enunciado" ALIGN="RIGHT">UK</TD></TR><TR><TD PORT="pregunta_l" ALIGN="LEFT">pregunta</TD><TD ALIGN="LEFT">varchar(300)</TD><TD PORT="pregunta" ALIGN="RIGHT"></TD></TR><TR><TD PORT="variable_l" ALIGN="LEFT">variable</TD><TD ALIGN="LEFT">varchar(40) ?</TD><TD PORT="variable" ALIGN="RIGHT"></TD></TR><TR><TD PORT="polaridad_l" ALIGN="LEFT">polaridad</TD><TD ALIGN="LEFT">tinyint (+1 / −1)</TD><TD PORT="polaridad" ALIGN="RIGHT"></TD></TR><TR><TD PORT="activo_l" ALIGN="LEFT">activo</TD><TD ALIGN="LEFT">tinyint(1)</TD><TD PORT="activo" ALIGN="RIGHT"></TD></TR></TABLE>>];
  "granulo" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#cfe2f3"><B>granulo</B></TD></TR><TR><TD PORT="id_l" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">smallint unsigned</TD><TD PORT="id" ALIGN="RIGHT">PK</TD></TR><TR><TD PORT="regla_l" ALIGN="LEFT">regla</TD><TD ALIGN="LEFT">varchar(6)</TD><TD PORT="regla" ALIGN="RIGHT">UK1,UK2</TD></TR><TR><TD PORT="hipotesis_id_l" ALIGN="LEFT">hipotesis_id</TD><TD ALIGN="LEFT">smallint unsigned</TD><TD PORT="hipotesis_id" ALIGN="RIGHT">FK</TD></TR><TR><TD PORT="evidencia_id_l" ALIGN="LEFT">evidencia_id</TD><TD ALIGN="LEFT">smallint unsigned</TD><TD PORT="evidencia_id" ALIGN="RIGHT">FK,UK2</TD></TR><TR><TD PORT="orden_l" ALIGN="LEFT">orden</TD><TD ALIGN="LEFT">tinyint unsigned</TD><TD PORT="orden" ALIGN="RIGHT">UK1</TD></TR><TR><TD PORT="conector_l" ALIGN="LEFT">conector</TD><TD ALIGN="LEFT">enum('If','And')</TD><TD PORT="conector" ALIGN="RIGHT"></TD></TR><TR><TD PORT="peso_l" ALIGN="LEFT">peso</TD><TD ALIGN="LEFT">decimal(4,2)</TD><TD PORT="peso" ALIGN="RIGHT"></TD></TR><TR><TD PORT="categoria_codigo_l" ALIGN="LEFT">categoria_codigo</TD><TD ALIGN="LEFT">char(1)</TD><TD PORT="categoria_codigo" ALIGN="RIGHT"></TD></TR><TR><TD PORT="categoria_nombre_l" ALIGN="LEFT">categoria_nombre</TD><TD ALIGN="LEFT">varchar(60)</TD><TD PORT="categoria_nombre" ALIGN="RIGHT"></TD></TR><TR><TD PORT="rama_codigo_l" ALIGN="LEFT">rama_codigo</TD><TD ALIGN="LEFT">char(2)</TD><TD PORT="rama_codigo" ALIGN="RIGHT"></TD></TR><TR><TD PORT="rama_nombre_l" ALIGN="LEFT">rama_nombre</TD><TD ALIGN="LEFT">varchar(80)</TD><TD PORT="rama_nombre" ALIGN="RIGHT"></TD></TR><TR><TD PORT="procesos_l" ALIGN="LEFT">procesos</TD><TD ALIGN="LEFT">varchar(20)</TD><TD PORT="procesos" ALIGN="RIGHT"></TD></TR><TR><TD PORT="conclusion_l" ALIGN="LEFT">conclusion</TD><TD ALIGN="LEFT">varchar(250)</TD><TD PORT="conclusion" ALIGN="RIGHT"></TD></TR><TR><TD PORT="accion_l" ALIGN="LEFT">accion</TD><TD ALIGN="LEFT">varchar(500)</TD><TD PORT="accion" ALIGN="RIGHT"></TD></TR><TR><TD PORT="factor_certeza_l" ALIGN="LEFT">factor_certeza</TD><TD ALIGN="LEFT">decimal(5,2)</TD><TD PORT="factor_certeza" ALIGN="RIGHT"></TD></TR><TR><TD PORT="riesgo_perdida_datos_l" ALIGN="LEFT">riesgo_perdida_datos</TD><TD ALIGN="LEFT">tinyint(1)</TD><TD PORT="riesgo_perdida_datos" ALIGN="RIGHT"></TD></TR><TR><TD PORT="fuente_l" ALIGN="LEFT">fuente</TD><TD ALIGN="LEFT">varchar(160)</TD><TD PORT="fuente" ALIGN="RIGHT"></TD></TR><TR><TD PORT="version_l" ALIGN="LEFT">version</TD><TD ALIGN="LEFT">int unsigned</TD><TD PORT="version" ALIGN="RIGHT"></TD></TR><TR><TD PORT="activo_l" ALIGN="LEFT">activo</TD><TD ALIGN="LEFT">tinyint(1)</TD><TD PORT="activo" ALIGN="RIGHT"></TD></TR><TR><TD PORT="creado_en_l" ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">datetime</TD><TD PORT="creado_en" ALIGN="RIGHT"></TD></TR><TR><TD PORT="actualizado_en_l" ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT">datetime</TD><TD PORT="actualizado_en" ALIGN="RIGHT"></TD></TR></TABLE>>];
  }
  subgraph cluster_op { label="Operación del motor de inferencia (4 tablas)"; fontsize=15; style=rounded; color="#6aa84f";
  "escala_respuesta" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9ead3"><B>escala_respuesta</B></TD></TR><TR><TD PORT="codigo_l" ALIGN="LEFT"><B>codigo</B></TD><TD ALIGN="LEFT">varchar(10)</TD><TD PORT="codigo" ALIGN="RIGHT">PK</TD></TR><TR><TD PORT="etiqueta_l" ALIGN="LEFT">etiqueta</TD><TD ALIGN="LEFT">varchar(40)</TD><TD PORT="etiqueta" ALIGN="RIGHT"></TD></TR><TR><TD PORT="valor_l" ALIGN="LEFT">valor</TD><TD ALIGN="LEFT">decimal(3,2)</TD><TD PORT="valor" ALIGN="RIGHT"></TD></TR><TR><TD PORT="orden_l" ALIGN="LEFT">orden</TD><TD ALIGN="LEFT">tinyint</TD><TD PORT="orden" ALIGN="RIGHT"></TD></TR><TR><TD PORT="color_l" ALIGN="LEFT">color</TD><TD ALIGN="LEFT">char(7)</TD><TD PORT="color" ALIGN="RIGHT"></TD></TR></TABLE>>];
  "consulta" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9ead3"><B>consulta</B></TD></TR><TR><TD PORT="id_l" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">int unsigned</TD><TD PORT="id" ALIGN="RIGHT">PK</TD></TR><TR><TD PORT="fecha_inicio_l" ALIGN="LEFT">fecha_inicio</TD><TD ALIGN="LEFT">datetime</TD><TD PORT="fecha_inicio" ALIGN="RIGHT"></TD></TR><TR><TD PORT="fecha_fin_l" ALIGN="LEFT">fecha_fin</TD><TD ALIGN="LEFT">datetime ?</TD><TD PORT="fecha_fin" ALIGN="RIGHT"></TD></TR><TR><TD PORT="equipo_l" ALIGN="LEFT">equipo</TD><TD ALIGN="LEFT">varchar(40) ?</TD><TD PORT="equipo" ALIGN="RIGHT"></TD></TR><TR><TD PORT="ubicacion_l" ALIGN="LEFT">ubicacion</TD><TD ALIGN="LEFT">varchar(100) ?</TD><TD PORT="ubicacion" ALIGN="RIGHT"></TD></TR><TR><TD PORT="descripcion_l" ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT">text ?</TD><TD PORT="descripcion" ALIGN="RIGHT"></TD></TR><TR><TD PORT="estado_l" ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">enum('EN_CURSO',…)</TD><TD PORT="estado" ALIGN="RIGHT"></TD></TR><TR><TD PORT="total_preguntas_l" ALIGN="LEFT">total_preguntas</TD><TD ALIGN="LEFT">smallint unsigned</TD><TD PORT="total_preguntas" ALIGN="RIGHT"></TD></TR><TR><TD PORT="parametros_l" ALIGN="LEFT">parametros</TD><TD ALIGN="LEFT">varchar(200) ?</TD><TD PORT="parametros" ALIGN="RIGHT"></TD></TR></TABLE>>];
  "consulta_respuesta" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9ead3"><B>consulta_respuesta</B></TD></TR><TR><TD PORT="id_l" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">int unsigned</TD><TD PORT="id" ALIGN="RIGHT">PK</TD></TR><TR><TD PORT="consulta_id_l" ALIGN="LEFT">consulta_id</TD><TD ALIGN="LEFT">int unsigned</TD><TD PORT="consulta_id" ALIGN="RIGHT">FK,UK</TD></TR><TR><TD PORT="orden_l" ALIGN="LEFT">orden</TD><TD ALIGN="LEFT">smallint unsigned</TD><TD PORT="orden" ALIGN="RIGHT"></TD></TR><TR><TD PORT="evidencia_id_l" ALIGN="LEFT">evidencia_id</TD><TD ALIGN="LEFT">smallint unsigned</TD><TD PORT="evidencia_id" ALIGN="RIGHT">FK,UK</TD></TR><TR><TD PORT="escala_codigo_l" ALIGN="LEFT">escala_codigo</TD><TD ALIGN="LEFT">varchar(10)</TD><TD PORT="escala_codigo" ALIGN="RIGHT">FK</TD></TR><TR><TD PORT="valor_l" ALIGN="LEFT">valor</TD><TD ALIGN="LEFT">decimal(3,2)</TD><TD PORT="valor" ALIGN="RIGHT"></TD></TR><TR><TD PORT="origen_l" ALIGN="LEFT">origen</TD><TD ALIGN="LEFT">enum('SINTOMA_INICIAL','PREGUNTA')</TD><TD PORT="origen" ALIGN="RIGHT"></TD></TR><TR><TD PORT="registrado_en_l" ALIGN="LEFT">registrado_en</TD><TD ALIGN="LEFT">datetime</TD><TD PORT="registrado_en" ALIGN="RIGHT"></TD></TR></TABLE>>];
  "consulta_hipotesis" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#d9ead3"><B>consulta_hipotesis</B></TD></TR><TR><TD PORT="consulta_id_l" ALIGN="LEFT"><B>consulta_id</B></TD><TD ALIGN="LEFT">int unsigned</TD><TD PORT="consulta_id" ALIGN="RIGHT">PK,FK</TD></TR><TR><TD PORT="posicion_l" ALIGN="LEFT"><B>posicion</B></TD><TD ALIGN="LEFT">tinyint unsigned (1..5)</TD><TD PORT="posicion" ALIGN="RIGHT">PK</TD></TR><TR><TD PORT="hipotesis_id_l" ALIGN="LEFT">hipotesis_id</TD><TD ALIGN="LEFT">smallint unsigned</TD><TD PORT="hipotesis_id" ALIGN="RIGHT">FK</TD></TR><TR><TD PORT="probabilidad_l" ALIGN="LEFT">probabilidad</TD><TD ALIGN="LEFT">decimal(6,5)</TD><TD PORT="probabilidad" ALIGN="RIGHT"></TD></TR><TR><TD PORT="certeza_l" ALIGN="LEFT">certeza</TD><TD ALIGN="LEFT">decimal(6,4)</TD><TD PORT="certeza" ALIGN="RIGHT"></TD></TR><TR><TD PORT="regla_principal_l" ALIGN="LEFT">regla_principal</TD><TD ALIGN="LEFT">varchar(6) ?</TD><TD PORT="regla_principal" ALIGN="RIGHT"></TD></TR></TABLE>>];
  }
  "hipotesis":"id" -> "granulo":"hipotesis_id_l";
  "evidencia":"id" -> "granulo":"evidencia_id_l";
  "consulta":"id" -> "consulta_respuesta":"consulta_id_l";
  "evidencia":"id" -> "consulta_respuesta":"evidencia_id_l";
  "escala_respuesta":"codigo" -> "consulta_respuesta":"escala_codigo_l";
  "consulta":"id" -> "consulta_hipotesis":"consulta_id_l";
  "hipotesis":"id" -> "consulta_hipotesis":"hipotesis_id_l";
}