digraph dfd2 {
  graph [fontname="DejaVu Sans", fontsize=20, rankdir=TB, labelloc=t, pad=0.35, dpi=160, nodesep=0.6, ranksep=0.75, splines=spline];
  node  [fontname="DejaVu Sans", fontsize=11];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#2b3a4f", fontcolor="#2b3a4f", arrowsize=0.7];
  label="DFD nivel 2 · Proceso 5.0 Diagnosticar con el motor de inferencia\n ";

  adm [shape=box, style="filled", fillcolor="#fde9c9", color="#b7791f", penwidth=2, label="Administrador"];
  adm2 [shape=box, style="filled", fillcolor="#fde9c9", color="#b7791f", penwidth=2, label="Administrador"];
  node [shape=plain];
  p1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1e8e5a" BGCOLOR="#e6f5ec"><TR><TD BGCOLOR="#1e8e5a"><FONT COLOR="white"><B>5.1</B></FONT></TD></TR><TR><TD>Abrir la ronda y<BR/>registrar síntomas</TD></TR></TABLE>>];
  p2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1e8e5a" BGCOLOR="#e6f5ec"><TR><TD BGCOLOR="#1e8e5a"><FONT COLOR="white"><B>5.2</B></FONT></TD></TR><TR><TD>Consultar gránulos<BR/>(encadenamiento<BR/>hacia adelante)</TD></TR></TABLE>>];
  p3 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1e8e5a" BGCOLOR="#e6f5ec"><TR><TD BGCOLOR="#1e8e5a"><FONT COLOR="white"><B>5.3</B></FONT></TD></TR><TR><TD>Registrar respuesta y<BR/>deducir observaciones</TD></TR></TABLE>>];
  p4 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1e8e5a" BGCOLOR="#e6f5ec"><TR><TD BGCOLOR="#1e8e5a"><FONT COLOR="white"><B>5.4</B></FONT></TD></TR><TR><TD>Evaluar gránulos y<BR/>calcular peso probabilístico</TD></TR></TABLE>>];
  p5 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1e8e5a" BGCOLOR="#e6f5ec"><TR><TD BGCOLOR="#1e8e5a"><FONT COLOR="white"><B>5.5</B></FONT></TD></TR><TR><TD>Seleccionar la siguiente<BR/>pregunta (ganancia<BR/>de información)</TD></TR></TABLE>>];
  p6 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1e8e5a" BGCOLOR="#e6f5ec"><TR><TD BGCOLOR="#1e8e5a"><FONT COLOR="white"><B>5.6</B></FONT></TD></TR><TR><TD>Generar el diagnóstico,<BR/>la explicación y<BR/>guardar la ronda</TD></TR></TABLE>>];
  k1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#8e6cef"><TR><TD SIDES="LTB" BGCOLOR="#e9e2fb"><B>K1</B></TD><TD SIDES="TB" BGCOLOR="#f6f2fe" ALIGN="LEFT">hipotesis</TD></TR></TABLE>>];
  k2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#8e6cef"><TR><TD SIDES="LTB" BGCOLOR="#e9e2fb"><B>K2</B></TD><TD SIDES="TB" BGCOLOR="#f6f2fe" ALIGN="LEFT">evidencia</TD></TR></TABLE>>];
  k3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#8e6cef"><TR><TD SIDES="LTB" BGCOLOR="#e9e2fb"><B>K3</B></TD><TD SIDES="TB" BGCOLOR="#f6f2fe" ALIGN="LEFT">granulo</TD></TR></TABLE>>];
  mt [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b6676"><TR><TD SIDES="LTB" BGCOLOR="#eef1f5"><B>M</B></TD><TD SIDES="TB" BGCOLOR="#f7f9fb" ALIGN="LEFT">memoria de trabajo (temporal)</TD></TR></TABLE>>];
  d6 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b6676"><TR><TD SIDES="LTB" BGCOLOR="#eef1f5"><B>D6</B></TD><TD SIDES="TB" BGCOLOR="#f7f9fb" ALIGN="LEFT">diagnostico · incidente_evidencia · diagnostico_hipotesis</TD></TR></TABLE>>];
  es [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b6676"><TR><TD SIDES="LTB" BGCOLOR="#eef1f5"><B>D9</B></TD><TD SIDES="TB" BGCOLOR="#f7f9fb" ALIGN="LEFT">escala_respuesta</TD></TR></TABLE>>];

  adm -> p1 [label="síntomas iniciales"];
  d6 -> p1 [label="hipótesis descartadas\ny evidencias de la ronda anterior"];
  p1 -> p2 [label="evidencias afirmadas"];
  k3 -> p2 [label="reglas que contienen la evidencia\n/ reglas de la categoría"];
  k2 -> p2 [label="evidencias de la\nmisma observación"];
  k1 -> p2 [label="hipótesis y\nprobabilidad previa"];
  p2 -> mt [label="gránulos e hipótesis\ndel diferencial"];
  adm -> p3 [label="respuesta graduada\no corrección"];
  es -> p3 [label="valor (−1 … +1)"];
  p3 -> mt [label="hecho y observaciones\ndeducidas"];
  p3 -> p2 [label="evidencia afirmada\n(nueva consulta granular)", style=dashed];
  mt -> p4 [label="hechos y gránulos"];
  p4 -> p5 [label="distribución de\nprobabilidad"];
  mt -> p5 [label="observaciones pendientes"];
  p5 -> adm2 [label="siguiente pregunta\ny su justificación"];
  p4 -> p6 [label="hipótesis ponderadas\n(peso y FC)"];
  p6 -> adm2 [label="5 hipótesis, reglas y\nacción recomendada"];
  p6 -> d6 [label="evidencias, hipótesis propuestas\ny versión del gránulo"];
  {rank=same; k1; k2; k3;}
}
