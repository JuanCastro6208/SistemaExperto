@startuml clases_dao_conocimiento
' Diagrama de clases DAO (parte 1): conexión, fábrica y base de conocimiento.
' Corresponde a sedati/datos/conexion.py, sedati/datos/dao/fabrica.py, interfaces.py y sql_conocimiento.py
allowmixing
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #5B6676
  ArrowColor #2B3A4F
  HeaderBackgroundColor #E7F0FE
}
skinparam package {
  BorderColor #9DB8E8
  FontColor #1F6FEB
}
title Diagrama de clases DAO · parte 1: conexión, fábrica y base de conocimiento (sedati_kb)

package "Capa de negocio (clientes de los DAO)" #F7F9FB {
  class MotorInferencia {
    + iniciar(sintoma_ids, descartadas)
    + responder(evidencia, opcion)
    + resultado(n): List<ResultadoHipotesis>
  }
  class ServicioDiagnostico
  class ServicioAdministracionConocimiento
  class ServicioAtencion
}

package "sedati.datos.dao" {
  class FabricaDAO {
    + conexion_kb: ConexionBD
    + conexion_trx: ConexionBD
    + conocimiento(): ConocimientoDAO
    + administracion_conocimiento(): AdministracionConocimientoDAO
    + catalogo(): CatalogoDAO
    + usuarios(): UsuarioDAO
    + bitacora_acceso(): BitacoraAccesoDAO
    + equipos(): EquipoDAO
    + incidentes(): IncidenteDAO
    + citas(): CitaDAO
    + diagnosticos(): DiagnosticoDAO
    + intervenciones(): IntervencionDAO
    + escalamientos(): EscalamientoDAO
    + auditoria(): AuditoriaDAO
    + indicadores(): IndicadoresDAO
    + verificar()
    + cerrar()
  }

  interface ConocimientoDAO <<interfaz>> {
    + suscribir(observador)
    + reglas_que_contienen(evidencia_ids): List<str>
    + reglas_de_categorias(categorias): List<str>
    + condiciones_de_reglas(reglas): List<fila>
    + hipotesis_por_ids(ids) / hipotesis_por_codigos(codigos)
    + evidencias_por_ids(ids) / evidencias_por_codigos(codigos)
    + evidencias_de_variables(variables)
    + reglas_de_hipotesis_mas_probables(excluir, limite)
    + categorias() / sintomas_por_categoria(c)
    + resumen_hipotesis(incluir_inactivas)
    + condiciones_de_hipotesis(id, incluir_inactivos)
    + listar_evidencias(incluir_inactivas)
    + estadisticas()
  }
  interface AdministracionConocimientoDAO <<interfaz>> {
    + siguiente_codigo(entidad): str
    + crear_hipotesis(codigo, nombre, dominio, previa): int
    + cambiar_estado_hipotesis(id, activo)
    + crear_evidencia(codigo, tipo, enunciado, pregunta, variable, polaridad): int
    + cambiar_estado_evidencia(id, activo)
    + filas_granulo(regla): List<fila>
    + crear_granulo(regla, hipotesis_id, condiciones, datos, ahora)
    + modificar_granulo(regla, cambios, ahora)
    + cambiar_estado_granulo(regla, activo, ahora)
    + ramas(): List<fila>
  }
  class ConocimientoDAOSQL {
    - _cx: ConexionBD
    - _observadores: List
    - _consultar(descripcion, sql, parametros)
  }
  class AdministracionConocimientoDAOSQL {
    - _cx: ConexionBD
  }
}

package "sedati.datos.conexion" {
  abstract class ConexionBD {
    + {abstract} consultar(sql, parametros): List<dict>
    + {abstract} ejecutar(sql, parametros): int
    + {abstract} transaccion(): contexto
    + {abstract} cerrar()
    + verificar()
    + uno(sql, parametros): dict
    + descripcion: str
  }
  class ConexionSQLite {
    - _cx: sqlite3.Connection
    + ruta: Path
    + creada: bool
  }
  class ConexionMySQL {
    - _cx: pymysql.Connection
    - _sql(sql): str
  }
  class ErrorIntegridad <<excepción>>
}

database "sedati_kb\n(hipotesis · evidencia · granulo)" as KB
database "sedati_trx\n(18 tablas)" as TRX

ConocimientoDAO <|.. ConocimientoDAOSQL
AdministracionConocimientoDAO <|.. AdministracionConocimientoDAOSQL
ConexionBD <|-- ConexionSQLite
ConexionBD <|-- ConexionMySQL
FabricaDAO o--> "2" ConexionBD
FabricaDAO ..> ConocimientoDAOSQL : <<crea>>
FabricaDAO ..> AdministracionConocimientoDAOSQL : <<crea>>
ConocimientoDAOSQL --> ConexionBD
AdministracionConocimientoDAOSQL --> ConexionBD
ConexionBD ..> ErrorIntegridad : <<lanza>>
ConexionBD ..> KB
ConexionBD ..> TRX

MotorInferencia --> ConocimientoDAO : consultas granulares
ServicioDiagnostico --> ConocimientoDAO
ServicioAdministracionConocimiento --> AdministracionConocimientoDAO
ServicioAtencion --> FabricaDAO
@enduml
