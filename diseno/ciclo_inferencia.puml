@startuml ciclo_inferencia
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #E7F0FE
  BorderColor #1F6FEB
  DiamondBackgroundColor #FDF4E3
  DiamondBorderColor #B7791F
}
title Ciclo del motor de inferencia (consultas sucesivas y granulares)

|Usuario|
start
:Marca los síntomas observados\ny los datos del equipo;
|Motor de inferencia|
:Registra los síntomas como hechos (valor +1);
|Base de conocimiento|
:SELECT reglas que contienen los síntomas\n(y sus evidencias equivalentes);
:SELECT el resto de reglas de esas categorías\n(diagnóstico diferencial);
:SELECT condiciones If / And de esas reglas,\nsus hipótesis y evidencias equivalentes;
|Motor de inferencia|
repeat
  :Evalúa cada gránulo en memoria:
  aplicabilidad(If) × grado(And) × FC del experto;
  :Combina los aportes por hipótesis (MYCIN)
  y calcula el peso probabilístico
  P(h) = previa_contextual(h) · e^(β·FC(h)) / Σ (normalizado);
  :Para cada observación pendiente simula «Sí» y «No»
  y calcula la ganancia de información;
  if (¿líder ≥ umbral, ganancia < mínima,\nsin preguntas o máximo alcanzado?) then (sí)
    :Recomienda concluir;
    break
  endif
  |Usuario|
  :Responde la pregunta de mayor ganancia
  (Sí / Probablemente sí / No sé / Probablemente no / No)
  o corrige una respuesta anterior;
  |Motor de inferencia|
  :Registra el hecho y deduce las evidencias
  de la misma observación (polaridad ±1);
  if (¿respuesta afirmativa?) then (sí)
    |Base de conocimiento|
    :SELECT reglas que contienen la evidencia
    (puede activar reglas de otras categorías);
    |Motor de inferencia|
  endif
repeat while (el usuario sigue respondiendo)
:Entrega las 5 hipótesis con su peso, la regla
que las sostiene, la explicación y la acción recomendada;
|Base de conocimiento|
:Guarda la consulta, las respuestas y el top 5;
stop
@enduml
