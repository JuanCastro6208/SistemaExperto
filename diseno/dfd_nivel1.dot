digraph dfd1 {
  graph [fontname="DejaVu Sans", fontsize=20, rankdir=LR, labelloc=t, pad=0.35, dpi=160, nodesep=0.35, ranksep=1.25, splines=spline, newrank=true];
  node  [fontname="DejaVu Sans", fontsize=11];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#2b3a4f", fontcolor="#2b3a4f", arrowsize=0.7];
  label="DFD nivel 1 · SEDATI\n ";

  // entidades externas
  sol [shape=box, style="filled", fillcolor="#fde9c9", color="#b7791f", penwidth=2, label="Solicitante"];
  adm [shape=box, style="filled", fillcolor="#fde9c9", color="#b7791f", penwidth=2, label="Administrador"];
  area [shape=box, style="filled", fillcolor="#fde9c9", color="#b7791f", penwidth=2, label="Área de\nescalamiento"];

  // procesos
  node [shape=plain];
  p1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1f6feb" BGCOLOR="#e7f0fe"><TR><TD BGCOLOR="#1f6feb"><FONT COLOR="white"><B>1.0</B></FONT></TD></TR><TR><TD>Autenticar y<BR/>controlar el acceso</TD></TR></TABLE>>];
  p2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1f6feb" BGCOLOR="#e7f0fe"><TR><TD BGCOLOR="#1f6feb"><FONT COLOR="white"><B>2.0</B></FONT></TD></TR><TR><TD>Gestionar cuentas<BR/>y roles</TD></TR></TABLE>>];
  p3 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1f6feb" BGCOLOR="#e7f0fe"><TR><TD BGCOLOR="#1f6feb"><FONT COLOR="white"><B>3.0</B></FONT></TD></TR><TR><TD>Registrar y asignar<BR/>el incidente</TD></TR></TABLE>>];
  p4 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1f6feb" BGCOLOR="#e7f0fe"><TR><TD BGCOLOR="#1f6feb"><FONT COLOR="white"><B>4.0</B></FONT></TD></TR><TR><TD>Programar y<BR/>atender citas</TD></TR></TABLE>>];
  p5 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1e8e5a" BGCOLOR="#e6f5ec"><TR><TD BGCOLOR="#1e8e5a"><FONT COLOR="white"><B>5.0</B></FONT></TD></TR><TR><TD>Diagnosticar con el<BR/>motor de inferencia<BR/><FONT POINT-SIZE="9">(detalle en el nivel 2)</FONT></TD></TR></TABLE>>];
  p6 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1f6feb" BGCOLOR="#e7f0fe"><TR><TD BGCOLOR="#1f6feb"><FONT COLOR="white"><B>6.0</B></FONT></TD></TR><TR><TD>Registrar solución,<BR/>cerrar o escalar</TD></TR></TABLE>>];
  p7 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#8e6cef" BGCOLOR="#f3effd"><TR><TD BGCOLOR="#8e6cef"><FONT COLOR="white"><B>7.0</B></FONT></TD></TR><TR><TD>Administrar la base<BR/>de conocimiento</TD></TR></TABLE>>];
  p8 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED" COLOR="#1f6feb" BGCOLOR="#e7f0fe"><TR><TD BGCOLOR="#1f6feb"><FONT COLOR="white"><B>8.0</B></FONT></TD></TR><TR><TD>Consultar historial,<BR/>indicadores y reportes</TD></TR></TABLE>>];

  // almacenes (sedati_trx = D, sedati_kb = K)
  d1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b6676"><TR><TD SIDES="LTB" BGCOLOR="#eef1f5"><B>D1</B></TD><TD SIDES="TB" BGCOLOR="#f7f9fb" ALIGN="LEFT">usuario · rol · modulo · rol_permiso</TD></TR></TABLE>>];
  d2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b6676"><TR><TD SIDES="LTB" BGCOLOR="#eef1f5"><B>D2</B></TD><TD SIDES="TB" BGCOLOR="#f7f9fb" ALIGN="LEFT">bitacora_acceso</TD></TR></TABLE>>];
  d3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b6676"><TR><TD SIDES="LTB" BGCOLOR="#eef1f5"><B>D3</B></TD><TD SIDES="TB" BGCOLOR="#f7f9fb" ALIGN="LEFT">equipo · tipo_equipo · dependencia</TD></TR></TABLE>>];
  d4 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b6676"><TR><TD SIDES="LTB" BGCOLOR="#eef1f5"><B>D4</B></TD><TD SIDES="TB" BGCOLOR="#f7f9fb" ALIGN="LEFT">incidente · incidente_historial</TD></TR></TABLE>>];
  d5 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b6676"><TR><TD SIDES="LTB" BGCOLOR="#eef1f5"><B>D5</B></TD><TD SIDES="TB" BGCOLOR="#f7f9fb" ALIGN="LEFT">cita</TD></TR></TABLE>>];
  d6 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b6676"><TR><TD SIDES="LTB" BGCOLOR="#eef1f5"><B>D6</B></TD><TD SIDES="TB" BGCOLOR="#f7f9fb" ALIGN="LEFT">diagnostico · incidente_evidencia · diagnostico_hipotesis</TD></TR></TABLE>>];
  d7 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b6676"><TR><TD SIDES="LTB" BGCOLOR="#eef1f5"><B>D7</B></TD><TD SIDES="TB" BGCOLOR="#f7f9fb" ALIGN="LEFT">intervencion · escalamiento</TD></TR></TABLE>>];
  d8 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5b6676"><TR><TD SIDES="LTB" BGCOLOR="#eef1f5"><B>D8</B></TD><TD SIDES="TB" BGCOLOR="#f7f9fb" ALIGN="LEFT">auditoria_conocimiento</TD></TR></TABLE>>];
  k1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#8e6cef"><TR><TD SIDES="LTB" BGCOLOR="#e9e2fb"><B>K</B></TD><TD SIDES="TB" BGCOLOR="#f6f2fe" ALIGN="LEFT">sedati_kb: hipotesis · evidencia · granulo</TD></TR></TABLE>>];

  // flujos
  sol -> p1 [label="credenciales"];
  adm -> p1 [label="credenciales"];
  d1 -> p1 [label="cuenta, hash y permisos"];
  p1 -> d2 [label="intento de ingreso"];
  p1 -> sol [label="sesión (token) y menú"];
  adm -> p2 [label="datos de la cuenta"];
  p2 -> d1 [label="cuenta y rol"];
  p2 -> adm [label="contraseña temporal"];
  sol -> p3 [label="reporte de la falla"];
  p3 -> d3 [label="equipo nuevo"];
  p3 -> d4 [label="incidente ABIERTO"];
  adm -> p3 [label="tomar / asignar"];
  sol -> p4 [label="cita, cambio o cancelación"];
  adm -> p4 [label="cita · atendida / no asistió"];
  d4 -> p4 [label="responsable"];
  p4 -> d5 [label="cita sin solape"];
  adm -> p5 [label="síntomas y\nrespuestas graduadas"];
  k1 -> p5 [label="gránulos consultados\nde forma granular"];
  d6 -> p5 [label="hipótesis descartadas\nen rondas anteriores"];
  p5 -> adm [label="preguntas · 5 hipótesis\ncon peso y explicación"];
  p5 -> d6 [label="ronda: evidencias e\nhipótesis propuestas"];
  p5 -> d4 [label="EN_DIAGNOSTICO\ny categoría"];
  adm -> p6 [label="decisión, solución\nresultado o escalamiento"];
  p6 -> d6 [label="CONFIRMADA / DESCARTADA"];
  p6 -> d7 [label="intervención o escalamiento"];
  p6 -> d4 [label="CERRADO / ESCALADO"];
  p6 -> area [label="incidente escalado"];
  adm -> p7 [label="hipótesis, evidencias,\ngránulos del experto"];
  p7 -> k1 [label="alta, versión,\nactivación"];
  p7 -> d8 [label="quién y cuándo"];
  d4 -> p8 [label="incidentes"];
  d6 -> p8 [label="rondas"];
  d7 -> p8 [label="soluciones"];
  p8 -> adm [label="historial por equipo,\nindicadores y CSV"];

  {rank=same; sol; adm;}
  {rank=same; p1; p2; p3; p4;}
  {rank=same; p5; p6; p7; p8;}
}
