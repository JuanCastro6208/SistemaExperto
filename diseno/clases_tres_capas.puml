@startuml clases_tres_capas
skinparam dpi 150
set separator none
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3D4B5C
  ArrowColor #3D4B5C
}
skinparam package {
  BorderColor #8896A8
}
title Diagrama de clases · SEDATI en tres capas

package "Capa de presentación  (sedati.presentacion)" #EEF3FB {
  class AplicacionSEDATI {
    - sesion : SesionDiagnostico
    + mostrar(vista)
    + iniciar_consulta(sintomas, equipo, ubicacion, descripcion)
    + ver_resultado()
    + finalizar_consulta()
    + abrir_consulta_guardada(id)
  }
  class VistaInicio
  class VistaConsulta {
    + cargar(sesion)
    + refrescar()
    - _responder(opcion)
    - _corregir(evidencia, etiqueta)
  }
  class VistaResultado
  class VistaConocimiento
  class VistaHistorial
  class GraficoProbabilidades
  class GraficoEvolucion
  AplicacionSEDATI *-- VistaInicio
  AplicacionSEDATI *-- VistaConsulta
  AplicacionSEDATI *-- VistaResultado
  AplicacionSEDATI *-- VistaConocimiento
  AplicacionSEDATI *-- VistaHistorial
  VistaConsulta *-- GraficoProbabilidades
  VistaConsulta *-- GraficoEvolucion
  VistaResultado *-- GraficoProbabilidades
}

package "Capa de negocio  (sedati.negocio)" #EEF8F1 {
  class ServicioDiagnostico {
    + opciones_respuesta() : list
    + categorias() / sintomas(categoria)
    + iniciar(sintoma_ids, ...) : SesionDiagnostico
    + historial()
    + reconstruir(consulta_id) : SesionDiagnostico
  }
  class ServicioConocimiento {
    + hipotesis() / granulos_de(id) / evidencias()
  }
  class SesionDiagnostico {
    + pregunta_actual : Pregunta
    + motivo_conclusion : str
    + responder(evidencia, opcion) : Pregunta
    + resultado() : list<ResultadoHipotesis>
    + explicar_pregunta() / explicar_hipotesis(r)
    + finalizar() / cancelar() / informe()
  }
  class MotorInferencia {
    + memoria : MemoriaTrabajo
    + traza_consultas : list
    + iniciar(sintoma_ids)
    + responder(evidencia, opcion)
    + evaluar_granulo(g, supuesto) : EvaluacionGranulo
    + probabilidades(supuesto) : dict
    + resultado(n) : list<ResultadoHipotesis>
    + siguiente_pregunta() : Pregunta
    + motivo_para_concluir(pregunta) : str
    - _cargar_reglas(reglas)
    - _cargar_grupos(evidencias)
  }
  class MemoriaTrabajo {
    + respuestas : dict
    + granulos : dict
    + hipotesis : dict
    + grupos : dict
    + registrar(evidencia, valor, escala, origen)
    + valor(evidencia, supuesto) : ValorEvidencia
    + ya_preguntada(evidencia) : bool
    + representante(evidencia) : Evidencia
  }
  class SelectorGananciaInformacion {
    + candidatas(motor) : list<Evidencia>
    + probabilidad_si(motor, q, P) : float
    + elegir(motor) : Pregunta
  }
  class "certeza «módulo»" as certeza {
    + grado_cumplimiento(pesos_valores)
    + aplicabilidad(valor_entrada, base)
    + combinar(a, b)
    + certeza_hipotesis(aportes)
    + distribucion(previas, certezas, beta)
    + entropia(probabilidades)
  }
  class "explicacion «módulo»" as explicacion {
    + por_que(motor, pregunta)
    + como(resultado, beta)
  }
  class Hipotesis
  class Evidencia
  class Granulo {
    + regla, factor_certeza, conclusion, accion
    + condiciones : list<Condicion>
  }
  class Condicion
  class EvaluacionGranulo
  class ResultadoHipotesis
  class Pregunta
  class OpcionRespuesta

  ServicioDiagnostico ..> SesionDiagnostico : crea
  SesionDiagnostico o-- MotorInferencia
  MotorInferencia *-- MemoriaTrabajo
  MotorInferencia o-- SelectorGananciaInformacion
  MotorInferencia ..> certeza
  SelectorGananciaInformacion ..> certeza
  SesionDiagnostico ..> explicacion
  MemoriaTrabajo o-- "*" Granulo
  MemoriaTrabajo o-- "*" Hipotesis
  Granulo *-- "1..*" Condicion
  Condicion --> Evidencia
  MotorInferencia ..> EvaluacionGranulo
  MotorInferencia ..> ResultadoHipotesis
  SelectorGananciaInformacion ..> Pregunta
  SesionDiagnostico o-- "5" OpcionRespuesta
}

package "Capa de datos  (sedati.datos)" #FBF3E8 {
  abstract class ConexionBD {
    + {abstract} consultar(sql, parametros) : list<dict>
    + {abstract} ejecutar(sql, parametros) : int
  }
  class ConexionSQLite
  class ConexionMySQL
  class RepositorioConocimiento {
    + reglas_que_contienen(evidencia_ids)
    + reglas_de_categorias(categorias)
    + condiciones_de_reglas(reglas)
    + hipotesis_por_ids(ids)
    + evidencias_de_variables(variables)
    + suscribir(observador)
  }
  class RepositorioConsultas {
    + crear(...) / guardar_respuesta(...)
    + finalizar(...) / listar() / obtener(id)
  }
  ConexionBD <|-- ConexionSQLite
  ConexionBD <|-- ConexionMySQL
  RepositorioConocimiento o-- ConexionBD
  RepositorioConsultas o-- ConexionBD
}

class "Base de datos sedati (MySQL 8 / SQLite)" as BD <<base de datos>> #F2F4F7 {
  hipotesis · evidencia · granulo
  escala_respuesta · consulta
  consulta_respuesta · consulta_hipotesis
}

AplicacionSEDATI --> ServicioDiagnostico
AplicacionSEDATI --> ServicioConocimiento
VistaConsulta --> SesionDiagnostico
MotorInferencia --> RepositorioConocimiento : consultas granulares\nsucesivas
SesionDiagnostico --> RepositorioConsultas
ServicioDiagnostico --> RepositorioConsultas
ServicioConocimiento --> RepositorioConocimiento
ConexionSQLite ..> BD
ConexionMySQL ..> BD
@enduml
