digraph "mr_kb" {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=0.9, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Modelo relacional de la base de conocimiento sedati_kb (ingeniería inversa de MySQL 8.0.46)\n ", pad=0.3, dpi=150];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [color="#2B3A4F", arrowsize=0.8, fontname="DejaVu Sans", fontsize=8];
  subgraph "cluster_sedati_kb" { label="sedati_kb"; fontsize=14; fontcolor="#8E6CEF"; style="rounded,dashed"; color="#8E6CEF";
    "sedati_kb.evidencia" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8E6CEF"><TR><TD COLSPAN="3" BGCOLOR="#F3EFFD"><B>evidencia</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#8E6CEF">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo"><FONT POINT-SIZE="9" COLOR="#8E6CEF">UK</FONT></TD><TD ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">char(5)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">enum('SINTOMA','PRUEBA')</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="enunciado"><FONT POINT-SIZE="9" COLOR="#8E6CEF">UK</FONT></TD><TD ALIGN="LEFT">enunciado</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">varchar(250)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pregunta"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">pregunta</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">varchar(300)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="variable"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">variable ?</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="polaridad"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">polaridad</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">activo</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">tinyint(1)</FONT></TD></TR></TABLE>>];
    "sedati_kb.granulo" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8E6CEF"><TR><TD COLSPAN="3" BGCOLOR="#F3EFFD"><B>granulo</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#8E6CEF">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="regla"><FONT POINT-SIZE="9" COLOR="#8E6CEF">UK</FONT></TD><TD ALIGN="LEFT">regla</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">varchar(6)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hipotesis_id"><FONT POINT-SIZE="9" COLOR="#8E6CEF">FK</FONT></TD><TD ALIGN="LEFT">hipotesis_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evidencia_id"><FONT POINT-SIZE="9" COLOR="#8E6CEF">FK UK</FONT></TD><TD ALIGN="LEFT">evidencia_id</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="orden"><FONT POINT-SIZE="9" COLOR="#8E6CEF">UK</FONT></TD><TD ALIGN="LEFT">orden</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="conector"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">conector</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">enum('If','And')</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="peso"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">peso</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">decimal(4,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="categoria_codigo"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">categoria_codigo</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">char(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="categoria_nombre"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">categoria_nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rama_codigo"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">rama_codigo</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">char(2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rama_nombre"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">rama_nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="procesos"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">procesos</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="conclusion"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">conclusion</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">varchar(250)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="accion"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">accion</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">varchar(500)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="factor_certeza"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">factor_certeza</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">decimal(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="riesgo_perdida_datos"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">riesgo_perdida_datos</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fuente"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">fuente</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">activo</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actualizado_en"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">datetime</FONT></TD></TR></TABLE>>];
    "sedati_kb.hipotesis" [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8E6CEF"><TR><TD COLSPAN="3" BGCOLOR="#F3EFFD"><B>hipotesis</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#8E6CEF">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo"><FONT POINT-SIZE="9" COLOR="#8E6CEF">UK</FONT></TD><TD ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">char(6)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="9" COLOR="#8E6CEF">UK</FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="dominio"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">dominio</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">enum('Hardware','Sistema operativo','Periféricos','Red','Software','Accesos')</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="probabilidad_previa"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">probabilidad_previa</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">decimal(7,5)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo"><FONT POINT-SIZE="9" COLOR="#8E6CEF"> </FONT></TD><TD ALIGN="LEFT">activo</TD><TD ALIGN="LEFT"><FONT COLOR="#5B6676" POINT-SIZE="9">tinyint(1)</FONT></TD></TR></TABLE>>];
  }
  "sedati_kb.granulo":"evidencia_id" -> "sedati_kb.evidencia":"id" [arrowhead=teetee, arrowtail=crowodot, dir=both];
  "sedati_kb.granulo":"hipotesis_id" -> "sedati_kb.hipotesis":"id" [arrowhead=teetee, arrowtail=crowodot, dir=both];
}