@startuml clases_dao_transaccional
' Diagrama de clases DAO (parte 2): base transaccional sedati_trx.
' Corresponde a sedati/datos/dao/interfaces.py, sql_transaccional.py y sedati/datos/dto.py
left to right direction
set separator none
skinparam dpi 130
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #5B6676
  ArrowColor #2B3A4F
}
title Diagrama de clases DAO · parte 2: base transaccional (sedati_trx)

package "Interfaces DAO (sedati.datos.dao.interfaces)" {
  interface UsuarioDAO <<interfaz>> {
    + por_id(id): UsuarioDTO
    + por_correo(correo): UsuarioDTO
    + listar(rol, solo_activos): List<UsuarioDTO>
    + existe(documento, correo, excepto_id): bool
    + crear(...): int
    + actualizar(id, rol_id, dependencia_id, nombre, correo)
    + cambiar_estado(id, activo)
    + cambiar_contrasena(id, hash, debe_cambiar)
    + registrar_fallo(id, intentos, bloqueado_hasta)
    + registrar_ingreso(id, fecha)
    + desbloquear(id)
  }
  interface BitacoraAccesoDAO <<interfaz>> {
    + registrar(usuario_id, correo, exitoso, motivo, ip, fecha)
    + recientes(limite)
  }
  interface CatalogoDAO <<interfaz>> {
    + roles() / dependencias() / tipos_equipo()
    + permisos_de_rol(rol): dict
    + matriz_permisos()
    + escala_respuestas()
  }
  interface EquipoDAO <<interfaz>> {
    + por_inventario(inv): EquipoDTO
    + por_id(id): EquipoDTO
    + crear(...): int
    + listar()
  }
  interface IncidenteDAO <<interfaz>> {
    + crear(solicitante, equipo, ubicacion, descripcion, fecha): int
    + por_id(id): IncidenteDTO
    + listar(filtros): List<IncidenteDTO>
    + asignar(id, administrador_id, usuario_id, fecha)
    + cambiar_estado(id, estado, usuario_id, fecha, categoria)
    + historial(id): List<EventoHistorialDTO>
    + de_equipo(equipo_id): List<IncidenteDTO>
  }
  interface CitaDAO <<interfaz>> {
    + crear(incidente, administrador, inicio, fin, lugar, creado_por, fecha): int
    + por_id(id) / de_incidente(id): CitaDTO
    + listar(administrador, solicitante, desde)
    + reprogramar(id, inicio, fin, lugar)
    + cambiar_estado(id, estado)
  }
  interface DiagnosticoDAO <<interfaz>> {
    + crear(incidente, registrado_por, parametros, datos, fecha): int
    + guardar_respuesta(id, orden, evidencia, escala, valor, origen, fecha)
    + finalizar(id, total_preguntas, propuestas, fecha)
    + cancelar(id, fecha)
    + por_id(id) / de_incidente(id) / listar(limite)
    + respuestas(id): List<RespuestaDTO>
    + hipotesis(id): List<HipotesisPropuestaDTO>
    + propuesta(id) / decidir(id, estado)
    + descartadas_de_incidente(id): List<str>
  }
  interface IntervencionDAO <<interfaz>> {
    + registrar(propuesta, administrador, accion, resultado, tiempo, obs, fecha)
    + de_incidente(id): List<IntervencionDTO>
  }
  interface EscalamientoDAO <<interfaz>> {
    + registrar(incidente, motivo, destino, escalado_por, fecha)
    + de_incidente(id): List<EscalamientoDTO>
  }
  interface AuditoriaDAO <<interfaz>> {
    + registrar(entidad, codigo, version, accion, usuario, detalle, fecha)
    + listar(codigo, limite): List<AuditoriaDTO>
  }
  interface IndicadoresDAO <<interfaz>> {
    + resumen(desde, hasta): dict
  }
}

package "Implementaciones SQL (sql_transaccional.py) · MySQL 8 y SQLite" {
  class UsuarioDAOSQL
  class BitacoraAccesoDAOSQL
  class CatalogoDAOSQL
  class EquipoDAOSQL
  class IncidenteDAOSQL
  class CitaDAOSQL
  class DiagnosticoDAOSQL
  class IntervencionDAOSQL
  class EscalamientoDAOSQL
  class AuditoriaDAOSQL
  class IndicadoresDAOSQL
}

package "DTO (sedati.datos.dto)" {
  class UsuarioDTO {
    id, rol_id, documento, nombre, correo
    rol_codigo, dependencia_id, activo
    intentos_fallidos, bloqueado_hasta
    - contrasena_hash
    + como_dict()
  }
  class EquipoDTO {
    id, inventario, tipo_equipo_id
    marca, modelo, ubicacion, activo
  }
  class IncidenteDTO {
    id, codigo, estado, solicitante_id
    administrador_id, equipo_id, ubicacion
    descripcion, categoria_codigo
    fecha_apertura, fecha_cierre, rondas
  }
  class EventoHistorialDTO
  class CitaDTO {
    id, incidente_id, administrador_id
    inicio, fin, lugar, estado
  }
  class DiagnosticoDTO {
    id, incidente_id, ronda, estado
    total_preguntas, fecha_inicio, fecha_fin
  }
  class RespuestaDTO
  class HipotesisPropuestaDTO {
    id, posicion, hipotesis_codigo
    granulo_codigo, granulo_version
    probabilidad, certeza, estado
  }
  class IntervencionDTO
  class EscalamientoDTO
  class AuditoriaDTO
}

class FabricaDAO
abstract class ConexionBD

UsuarioDAO <|.. UsuarioDAOSQL
BitacoraAccesoDAO <|.. BitacoraAccesoDAOSQL
CatalogoDAO <|.. CatalogoDAOSQL
EquipoDAO <|.. EquipoDAOSQL
IncidenteDAO <|.. IncidenteDAOSQL
CitaDAO <|.. CitaDAOSQL
DiagnosticoDAO <|.. DiagnosticoDAOSQL
IntervencionDAO <|.. IntervencionDAOSQL
EscalamientoDAO <|.. EscalamientoDAOSQL
AuditoriaDAO <|.. AuditoriaDAOSQL
IndicadoresDAO <|.. IndicadoresDAOSQL

UsuarioDAOSQL ..> UsuarioDTO
EquipoDAOSQL ..> EquipoDTO
IncidenteDAOSQL ..> IncidenteDTO
IncidenteDAOSQL ..> EventoHistorialDTO
CitaDAOSQL ..> CitaDTO
DiagnosticoDAOSQL ..> DiagnosticoDTO
DiagnosticoDAOSQL ..> RespuestaDTO
DiagnosticoDAOSQL ..> HipotesisPropuestaDTO
IntervencionDAOSQL ..> IntervencionDTO
EscalamientoDAOSQL ..> EscalamientoDTO
AuditoriaDAOSQL ..> AuditoriaDTO

FabricaDAO ..> "Implementaciones SQL (sql_transaccional.py) · MySQL 8 y SQLite" : <<crea>>
"Implementaciones SQL (sql_transaccional.py) · MySQL 8 y SQLite" --> ConexionBD : usa (sedati_trx)
@enduml
