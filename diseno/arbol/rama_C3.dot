  edge [color="#8A94A6", fontname="DejaVu Sans", fontsize=8, fontcolor="#5B6676", arrowsize=0.6];
  raiz [label="C3 · Errores después de una\nactualización\n(P-25)", shape=box, style="rounded,filled,bold", fillcolor="#FEF7E0", color="#B7791F", fontsize=11];
  n1 [label="el equipo presenta fallas\ndespués de una\nactualización\n[E-049]"];
  raiz -> n1 [label="If"];
  n2 [label="el administrador de\ndispositivos reporta\nadvertencia en un\ndispositivo\n[E-050]"];
  n1 -> n2 [label="And"];
  h_R26 [label="R-26 · FC 85 %\nla falla está en un\ncontrolador incompatible", fillcolor="#FEF7E0", color="#B7791F", shape=note, style="filled"];
  n2 -> h_R26 [label="Then", color="#B7791F"];
  n3 [label="el historial reporta la\nactualización como fallida\n[E-051]"];
  n1 -> n3 [label="And"];
  h_R27 [label="R-27 · FC 80 %\nla falla está en los archivos\nde actualización", fillcolor="#FEF7E0", color="#B7791F", shape=note, style="filled"];
  n3 -> h_R27 [label="Then", color="#B7791F"];
  n4 [label="la falla desaparece al\nrestaurar el punto\nanterior\n[E-052]"];
  n1 -> n4 [label="And"];
  h_R28 [label="R-28 · FC 90 %\nla causa corresponde a la\nactualización aplicada", fillcolor="#FEF7E0", color="#B7791F", shape=note, style="filled"];
  n4 -> h_R28 [label="Then", color="#B7791F"];
}