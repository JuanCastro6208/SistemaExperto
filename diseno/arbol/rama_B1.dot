digraph "rama_B1" {
  graph [rankdir=LR, splines=true, nodesep=0.22, ranksep=0.55, fontname="DejaVu Sans", bgcolor="white", pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#5B6676", fontname="DejaVu Sans", fontsize=10, margin="0.10,0.05"];
  edge [color="#8A94A6", fontname="DejaVu Sans", fontsize=8, fontcolor="#5B6676", arrowsize=0.6];
  raiz [label="B1 · Equipo enciende sin imagen\n(P-02)", shape=box, style="rounded,filled,bold", fillcolor="#E6F4EA", color="#1E8E5A", fontsize=11];
  n1 [label="el equipo enciende\n[E-021]"];
  raiz -> n1 [label="If"];
  n2 [label="la pantalla no muestra\nimagen\n[E-022]"];
  n1 -> n2 [label="And"];
  n3 [label="el monitor no enciende su\nindicador\n[E-023]"];
  n2 -> n3 [label="And"];
  h_R12 [label="R-12 · FC 85 %\nla falla está en el monitor o\nen su alimentación", fillcolor="#E6F4EA", color="#1E8E5A", shape=note, style="filled"];
  n3 -> h_R12 [label="Then", color="#1E8E5A"];
  n4 [label="el monitor muestra el\nmensaje de ausencia de\nseñal\n[E-024]"];
  n1 -> n4 [label="And"];
  n5 [label="el equipo emite la\nsecuencia de pitidos de\nPOST\n[E-025]"];
  n4 -> n5 [label="And"];
  h_R13 [label="R-13 · FC 85 %\nla falla está en la memoria\nRAM o en la tarjeta de video\nmal asentada", fillcolor="#E6F4EA", color="#1E8E5A", shape=note, style="filled"];
  n5 -> h_R13 [label="Then", color="#1E8E5A"];
  n6 [label="el equipo no emite pitidos\nde POST\n[E-026]"];
  n4 -> n6 [label="And"];
  n7 [label="el monitor funciona en\notro equipo\n[E-027]"];
  n6 -> n7 [label="And"];
  h_R14 [label="R-14 · FC 80 %\nla falla está en el cable de\nvideo, el puerto seleccionado\no la tarjeta gráfica", fillcolor="#E6F4EA", color="#1E8E5A", shape=note, style="filled"];
  n7 -> h_R14 [label="Then", color="#1E8E5A"];
}