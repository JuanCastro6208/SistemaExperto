digraph "rama_F1" {
  graph [rankdir=LR, splines=true, nodesep=0.22, ranksep=0.55, fontname="DejaVu Sans", bgcolor="white", pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#5B6676", fontname="DejaVu Sans", fontsize=10, margin="0.10,0.05"];
  edge [color="#8A94A6", fontname="DejaVu Sans", fontsize=8, fontcolor="#5B6676", arrowsize=0.6];
  raiz [label="F1 · Equipo sin conexión a Internet\n(P-14, P-15)", shape=box, style="rounded,filled,bold", fillcolor="#E0F7FA", color="#0F8B8D", fontsize=11];
  n1 [label="el equipo no tiene\nconexión a Internet\n[E-088]"];
  raiz -> n1 [label="If"];
  n2 [label="obtiene una dirección del\nrango 169.254.x.x\n[E-089]"];
  n1 -> n2 [label="And"];
  n3 [label="otros equipos del mismo\npunto presentan el mismo\ncomportamiento\n[E-090]"];
  n2 -> n3 [label="And"];
  h_R50 [label="R-50 · FC 90 %\nla falla está en el servicio\nDHCP o en la VLAN del switch", fillcolor="#E0F7FA", color="#0F8B8D", shape=note, style="filled"];
  n3 -> h_R50 [label="Then", color="#0F8B8D"];
  n4 [label="el equipo sí obtiene\ndirección en otro punto de\nred\n[E-091]"];
  n2 -> n4 [label="And"];
  h_R51 [label="R-51 · FC 85 %\nla falla está en el punto de\nred, el cable o el puerto del\nswitch", fillcolor="#E0F7FA", color="#0F8B8D", shape=note, style="filled"];
  n4 -> h_R51 [label="Then", color="#0F8B8D"];
  n5 [label="obtiene dirección IP del\nrango institucional\n[E-092]"];
  n1 -> n5 [label="And"];
  n6 [label="no obtiene respuesta de la\npuerta de enlace\n[E-093]"];
  n5 -> n6 [label="And"];
  h_R52 [label="R-52 · FC 80 %\nla falla está en el switch de\nacceso, la VLAN o el cableado\nhorizontal", fillcolor="#E0F7FA", color="#0F8B8D", shape=note, style="filled"];
  n6 -> h_R52 [label="Then", color="#0F8B8D"];
  n7 [label="obtiene respuesta de la\npuerta de enlace\n[E-094]"];
  n1 -> n7 [label="And"];
  n8 [label="no obtiene respuesta de\nuna dirección pública\n[E-095]"];
  n7 -> n8 [label="And"];
  h_R53 [label="R-53 · FC 85 %\nla falla está en la salida a\nInternet o en el filtrado\nperimetral", fillcolor="#E0F7FA", color="#0F8B8D", shape=note, style="filled"];
  n8 -> h_R53 [label="Then", color="#0F8B8D"];
  n9 [label="obtiene respuesta de una\ndirección pública\n[E-096]"];
  n1 -> n9 [label="And"];
  n10 [label="no resuelve nombres de\ndominio\n[E-097]"];
  n9 -> n10 [label="And"];
  h_R54 [label="R-54 · FC 90 %\nla falla está en el servicio\nde resolución de nombres", fillcolor="#E0F7FA", color="#0F8B8D", shape=note, style="filled"];
  n10 -> h_R54 [label="Then", color="#0F8B8D"];
}