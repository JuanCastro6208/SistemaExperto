digraph "arbol_general" {
  graph [rankdir=LR, splines=true, nodesep=0.22, ranksep=0.55, fontname="DejaVu Sans", bgcolor="white", pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#5B6676", fontname="DejaVu Sans", fontsize=10, margin="0.10,0.05"];
  edge [color="#8A94A6", fontname="DejaVu Sans", fontsize=8, fontcolor="#5B6676", arrowsize=0.6];
  raiz [label="INCIDENTE TECNOLÓGICO\nREPORTADO\n(22 ramas · 88 fallas)", shape=box, style="rounded,filled,bold", fillcolor="#18212D", fontcolor="white", fontsize=12];
  cA [label="A. Energía y arranque\n11 fallas", style="rounded,filled,bold", fillcolor="#E8F0FE", color="#1F6FEB", fontsize=11];
  raiz -> cA;
  rA1 [label="A1 · Equipo no enciende\nP-01", fillcolor="white", color="#1F6FEB"];
  cA -> rA1 [label="If"];
  fA1 [label="R-01 la red eléctrica, el regulador o la\l    multitoma\lR-02 la fuente de alimentación\lR-03 el pulsador de encendido del chasis\lR-04 la memoria RAM, el procesador o la placa\l    madre\l", shape=note, style="filled", fillcolor="#E8F0FE", color="#1F6FEB", fontsize=8];
  rA1 -> fA1 [label="Then (4)", color="#1F6FEB"];
  rA2 [label="A2 · Equipo se apaga solo\nP-05", fillcolor="white", color="#1F6FEB"];
  cA -> rA2 [label="If"];
  fA2 [label="R-05 el sistema de disipación del equipo\lR-06 el ventilador del disipador\lR-07 la fuente de poder o en la alimentación\l    eléctrica del puesto\l", shape=note, style="filled", fillcolor="#E8F0FE", color="#1F6FEB", fontsize=8];
  rA2 -> fA2 [label="Then (3)", color="#1F6FEB"];
  rA3 [label="A3 · Reinicios inesperados\nP-04", fillcolor="white", color="#1F6FEB"];
  cA -> rA3 [label="If"];
  fA3 [label="R-08 el controlador identificado\lR-09 la memoria RAM\lR-10 el sobrecalentamiento del procesador\lR-11 la fuente de poder\l", shape=note, style="filled", fillcolor="#E8F0FE", color="#1F6FEB", fontsize=8];
  rA3 -> fA3 [label="Then (4)", color="#1F6FEB"];
  cB [label="B. Video y pantalla\n6 fallas", style="rounded,filled,bold", fillcolor="#E6F4EA", color="#1E8E5A", fontsize=11];
  raiz -> cB;
  rB1 [label="B1 · Equipo enciende sin imagen\nP-02", fillcolor="white", color="#1E8E5A"];
  cB -> rB1 [label="If"];
  fB1 [label="R-12 el monitor o en su alimentación\lR-13 la memoria RAM o en la tarjeta de video\l    mal asentada\lR-14 el cable de video, el puerto seleccionado\l    o la tarjeta gráfica\l", shape=note, style="filled", fillcolor="#E6F4EA", color="#1E8E5A", fontsize=8];
  rB1 -> fB1 [label="Then (3)", color="#1E8E5A"];
  rB2 [label="B2 · Imagen distorsionada\nP-09", fillcolor="white", color="#1E8E5A"];
  cB -> rB2 [label="If"];
  fB2 [label="R-15 el cable de video\lR-16 la tarjeta gráfica\lR-17 la configuración de video o en el\l    controlador gráfico\l", shape=note, style="filled", fillcolor="#E6F4EA", color="#1E8E5A", fontsize=8];
  rB2 -> fB2 [label="Then (3)", color="#1E8E5A"];
  cC [label="C. Sistema operativo y\nrendimiento\n11 fallas", style="rounded,filled,bold", fillcolor="#FEF7E0", color="#B7791F", fontsize=11];
  raiz -> cC;
  rC1 [label="C1 · Sistema operativo no inicia\nP-03", fillcolor="white", color="#B7791F"];
  cC -> rC1 [label="If"];
  fC1 [label="R-18 el disco o en su conexión\lR-19 el registro o la partición de arranque\lR-20 la actualización aplicada\lR-21 archivos del sistema corruptos o en un\l    controlador incompatible\l", shape=note, style="filled", fillcolor="#FEF7E0", color="#B7791F", fontsize=8];
  rC1 -> fC1 [label="Then (4)", color="#B7791F"];
  rC2 [label="C2 · Equipo demasiado lento\nP-06", fillcolor="white", color="#B7791F"];
  cC -> rC2 [label="If"];
  fC2 [label="R-22 la saturación del disco\lR-23 software malicioso instalado\lR-24 la insuficiencia de memoria RAM\lR-25 el disco de almacenamiento\l", shape=note, style="filled", fillcolor="#FEF7E0", color="#B7791F", fontsize=8];
  rC2 -> fC2 [label="Then (4)", color="#B7791F"];
  rC3 [label="C3 · Errores después de una\nactualización\nP-25", fillcolor="white", color="#B7791F"];
  cC -> rC3 [label="If"];
  fC3 [label="R-26 un controlador incompatible\lR-27 los archivos de actualización\lR-28 la causa corresponde a la actualización\l    aplicada\l", shape=note, style="filled", fillcolor="#FEF7E0", color="#B7791F", fontsize=8];
  rC3 -> fC3 [label="Then (3)", color="#B7791F"];
  cD [label="D. Almacenamiento y\nmemoria\n8 fallas", style="rounded,filled,bold", fillcolor="#FCE8E6", color="#C9473D", fontsize=11];
  raiz -> cD;
  rD1 [label="D1 · Disco duro no reconocido\nP-07", fillcolor="white", color="#C9473D"];
  cD -> rD1 [label="If"];
  fD1 [label="R-29 el disco\lR-30 el cable de conexión o en el puerto de la\l    placa\lR-31 la asignación de la partición\lR-32 el sistema de archivos\l", shape=note, style="filled", fillcolor="#FCE8E6", color="#C9473D", fontsize=8];
  rD1 -> fD1 [label="Then (4)", color="#C9473D"];
  rD2 [label="D2 · Memoria RAM no reconocida\nP-08", fillcolor="white", color="#C9473D"];
  cD -> rD2 [label="If"];
  fD2 [label="R-33 el módulo retirado\lR-34 la ranura de memoria\lR-35 la diferencia corresponde a la memoria\l    reservada por el video\lR-36 el módulo de memoria\l", shape=note, style="filled", fillcolor="#FCE8E6", color="#C9473D", fontsize=8];
  rD2 -> fD2 [label="Then (4)", color="#C9473D"];
  cE [label="E. Periféricos\n13 fallas", style="rounded,filled,bold", fillcolor="#F3E8FD", color="#8E6CEF", fontsize=11];
  raiz -> cE;
  rE1 [label="E1 · Teclado o mouse no responde\nP-10, P-11", fillcolor="white", color="#8E6CEF"];
  cE -> rE1 [label="If"];
  fE1 [label="R-37 el puerto USB utilizado\lR-38 el controlador del bus USB\lR-39 el periférico\lR-40 el receptor inalámbrico o en el\l    dispositivo\l", shape=note, style="filled", fillcolor="#F3E8FD", color="#8E6CEF", fontsize=8];
  rE1 -> fE1 [label="Then (4)", color="#8E6CEF"];
  rE2 [label="E2 · Dispositivo USB no\nreconocido\nP-12", fillcolor="white", color="#8E6CEF"];
  cE -> rE2 [label="If"];
  fE2 [label="R-41 el puerto utilizado o en su alimentación\lR-42 el controlador USB del sistema\lR-43 la causa corresponde a una política\l    institucional\lR-44 el dispositivo\l", shape=note, style="filled", fillcolor="#F3E8FD", color="#8E6CEF", fontsize=8];
  rE2 -> fE2 [label="Then (4)", color="#8E6CEF"];
  rE3 [label="E3 · Impresora no imprime\nP-13", fillcolor="white", color="#8E6CEF"];
  cE -> rE3 [label="If"];
  fE3 [label="R-45 el direccionamiento de la impresora\lR-46 la conexión física o en la alimentación\l    de la impresora\lR-47 el servicio de cola de impresión\lR-48 el controlador de impresión del equipo\lR-49 el consumible o en el atasco reportado\l", shape=note, style="filled", fillcolor="#F3E8FD", color="#8E6CEF", fontsize=8];
  rE3 -> fE3 [label="Then (5)", color="#8E6CEF"];
  cF [label="F. Red y conectividad\n15 fallas", style="rounded,filled,bold", fillcolor="#E0F7FA", color="#0F8B8D", fontsize=11];
  raiz -> cF;
  rF1 [label="F1 · Equipo sin conexión a\nInternet\nP-14, P-15", fillcolor="white", color="#0F8B8D"];
  cF -> rF1 [label="If"];
  fF1 [label="R-50 el servicio DHCP o en la VLAN del switch\lR-51 el punto de red, el cable o el puerto del\l    switch\lR-52 el switch de acceso, la VLAN o el\l    cableado horizontal\lR-53 la salida a Internet o en el filtrado\l    perimetral\lR-54 el servicio de resolución de nombres\l", shape=note, style="filled", fillcolor="#E0F7FA", color="#0F8B8D", fontsize=8];
  rF1 -> fF1 [label="Then (5)", color="#0F8B8D"];
  rF2 [label="F2 · No resuelve nombres de\ndominio\nP-17", fillcolor="white", color="#0F8B8D"];
  cF -> rF2 [label="If"];
  fF2 [label="R-55 la disponibilidad del servidor DNS\lR-56 la configuración DNS del adaptador\lR-57 el sufijo DNS o en la pertenencia del\l    equipo al dominio\l", shape=note, style="filled", fillcolor="#E0F7FA", color="#0F8B8D", fontsize=8];
  rF2 -> fF2 [label="Then (3)", color="#0F8B8D"];
  rF3 [label="F3 · Conexión lenta o inestable\nP-18", fillcolor="white", color="#0F8B8D"];
  cF -> rF3 [label="If"];
  fF3 [label="R-58 el cableado o en el puerto del switch\lR-59 el cable de red\lR-60 la cobertura inalámbrica\lR-61 la congestión del segmento o en el enlace\l    de la institución\l", shape=note, style="filled", fillcolor="#E0F7FA", color="#0F8B8D", fontsize=8];
  rF3 -> fF3 [label="Then (4)", color="#0F8B8D"];
  rF4 [label="F4 · Sin comunicación con la red\nlocal\nP-16", fillcolor="white", color="#0F8B8D"];
  cF -> rF4 [label="If"];
  fF4 [label="R-62 la configuración del firewall local\lR-63 la configuración de direccionamiento del\l    equipo\lR-64 la segmentación o en el enrutamiento\l    entre VLAN\l", shape=note, style="filled", fillcolor="#E0F7FA", color="#0F8B8D", fontsize=8];
  rF4 -> fF4 [label="Then (3)", color="#0F8B8D"];
  cG [label="G. Software y accesos\n24 fallas", style="rounded,filled,bold", fillcolor="#FFF0E0", color="#D9822B", fontsize=11];
  raiz -> cG;
  rG1 [label="G1 · Usuario no puede iniciar\nsesión\nP-19", fillcolor="white", color="#D9822B"];
  cG -> rG1 [label="If"];
  fG1 [label="R-65 el bloqueo de la cuenta\lR-66 la expiración de la contraseña\lR-67 la conectividad del equipo con el dominio\lR-68 la relación de confianza del equipo con\l    el dominio\lR-69 la sincronización horaria del equipo\l", shape=note, style="filled", fillcolor="#FFF0E0", color="#D9822B", fontsize=8];
  rG1 -> fG1 [label="Then (5)", color="#D9822B"];
  rG2 [label="G2 · Falla de una aplicación\nP-20, P-21", fillcolor="white", color="#D9822B"];
  cG -> rG2 [label="If"];
  fG2 [label="R-70 las dependencias de la aplicación\lR-71 los permisos de ejecución\lR-72 el perfil del usuario\lR-73 los archivos de la aplicación\lR-74 la insuficiencia de memoria\lR-75 un complemento instalado\l", shape=note, style="filled", fillcolor="#FFF0E0", color="#D9822B", fontsize=8];
  rG2 -> fG2 [label="Then (6)", color="#D9822B"];
  rG3 [label="G3 · No se puede instalar\nsoftware\nP-22", fillcolor="white", color="#D9822B"];
  cG -> rG3 [label="If"];
  fG3 [label="R-76 los permisos de la cuenta\lR-77 la causa corresponde a una política de\l    restricción de software\lR-78 el espacio de almacenamiento disponible\lR-79 el archivo de instalación\lR-80 la causa corresponde al bloqueo de la\l    herramienta de protección\l", shape=note, style="filled", fillcolor="#FFF0E0", color="#D9822B", fontsize=8];
  rG3 -> fG3 [label="Then (5)", color="#D9822B"];
  rG4 [label="G4 · Antivirus presenta errores\nP-23", fillcolor="white", color="#D9822B"];
  cG -> rG4 [label="If"];
  fG4 [label="R-81 la instalación de la herramienta\lR-82 el conflicto entre herramientas de\l    protección\lR-83 la vigencia de la licencia\lR-84 la conectividad con el servidor de\l    actualizaciones\l", shape=note, style="filled", fillcolor="#FFF0E0", color="#D9822B", fontsize=8];
  rG4 -> fG4 [label="Then (4)", color="#D9822B"];
  rG5 [label="G5 · Sin acceso a recursos\ncompartidos\nP-24", fillcolor="white", color="#D9822B"];
  cG -> rG5 [label="If"];
  fG5 [label="R-85 las credenciales almacenadas\lR-86 los permisos asignados al usuario\lR-87 la disponibilidad del servidor\lR-88 la resolución de nombres del equipo\l", shape=note, style="filled", fillcolor="#FFF0E0", color="#D9822B", fontsize=8];
  rG5 -> fG5 [label="Then (4)", color="#D9822B"];
}