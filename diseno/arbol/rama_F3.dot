digraph "rama_F3" {
  graph [rankdir=LR, splines=true, nodesep=0.22, ranksep=0.55, fontname="DejaVu Sans", bgcolor="white", pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#5B6676", fontname="DejaVu Sans", fontsize=10, margin="0.10,0.05"];
  edge [color="#8A94A6", fontname="DejaVu Sans", fontsize=8, fontcolor="#5B6676", arrowsize=0.6];
  raiz [label="F3 · Conexión lenta o inestable\n(P-18)", shape=box, style="rounded,filled,bold", fillcolor="#E0F7FA", color="#0F8B8D", fontsize=11];
  n1 [label="la conexión de red es\nlenta o inestable\n[E-103]"];
  raiz -> n1 [label="If"];
  n2 [label="el adaptador negocia el\nenlace a 10 o 100 Mbps en\nun puerto de mayor\ncapacidad\n[E-104]"];
  n1 -> n2 [label="And"];
  h_R58 [label="R-58 · FC 85 %\nla falla está en el cableado o\nen el puerto del switch", fillcolor="#E0F7FA", color="#0F8B8D", shape=note, style="filled"];
  n2 -> h_R58 [label="Then", color="#0F8B8D"];
  n3 [label="el desempeño mejora al\nutilizar otro cable de red\n[E-105]"];
  n1 -> n3 [label="And"];
  h_R59 [label="R-59 · FC 90 %\nla falla está en el cable de\nred", fillcolor="#E0F7FA", color="#0F8B8D", shape=note, style="filled"];
  n3 -> h_R59 [label="Then", color="#0F8B8D"];
  n4 [label="la falla se presenta\núnicamente en la red\ninalámbrica\n[E-106]"];
  n1 -> n4 [label="And"];
  n5 [label="el nivel de señal es bajo\nen la ubicación del equipo\n[E-107]"];
  n4 -> n5 [label="And"];
  h_R60 [label="R-60 · FC 80 %\nla falla está en la cobertura\ninalámbrica", fillcolor="#E0F7FA", color="#0F8B8D", shape=note, style="filled"];
  n5 -> h_R60 [label="Then", color="#0F8B8D"];
  n6 [label="la degradación afecta a\ntodos los equipos de la\nsala\n[E-108]"];
  n1 -> n6 [label="And"];
  h_R61 [label="R-61 · FC 75 %\nla falla está en la congestión\ndel segmento o en el enlace de\nla institución", fillcolor="#E0F7FA", color="#0F8B8D", shape=note, style="filled"];
  n6 -> h_R61 [label="Then", color="#0F8B8D"];
}