digraph "rama_A3" {
  graph [rankdir=LR, splines=true, nodesep=0.22, ranksep=0.55, fontname="DejaVu Sans", bgcolor="white", pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#5B6676", fontname="DejaVu Sans", fontsize=10, margin="0.10,0.05"];
  edge [color="#8A94A6", fontname="DejaVu Sans", fontsize=8, fontcolor="#5B6676", arrowsize=0.6];
  raiz [label="A3 · Reinicios inesperados\n(P-04)", shape=box, style="rounded,filled,bold", fillcolor="#E8F0FE", color="#1F6FEB", fontsize=11];
  n1 [label="el equipo se reinicia de\nforma inesperada\n[E-014]"];
  raiz -> n1 [label="If"];
  n2 [label="aparece pantalla azul con\ncódigo de detención\n[E-015]"];
  n1 -> n2 [label="And"];
  n3 [label="el volcado de memoria\nseñala un controlador\nespecífico\n[E-016]"];
  n2 -> n3 [label="And"];
  h_R08 [label="R-08 · FC 85 %\nla falla está en el\ncontrolador identificado", fillcolor="#E8F0FE", color="#1F6FEB", shape=note, style="filled"];
  n3 -> h_R08 [label="Then", color="#1F6FEB"];
  n4 [label="el diagnóstico de memoria\nreporta errores\n[E-017]"];
  n1 -> n4 [label="And"];
  h_R09 [label="R-09 · FC 90 %\nla falla está en la memoria\nRAM", fillcolor="#E8F0FE", color="#1F6FEB", shape=note, style="filled"];
  n4 -> h_R09 [label="Then", color="#1F6FEB"];
  n5 [label="no aparece mensaje de\nerror\n[E-018]"];
  n1 -> n5 [label="And"];
  n6 [label="la temperatura del\nprocesador supera el\nlímite del fabricante\n[E-019]"];
  n5 -> n6 [label="And"];
  h_R10 [label="R-10 · FC 80 %\nla falla está en el\nsobrecalentamiento del\nprocesador", fillcolor="#E8F0FE", color="#1F6FEB", shape=note, style="filled"];
  n6 -> h_R10 [label="Then", color="#1F6FEB"];
  n7 [label="la temperatura y la\nmemoria se encuentran en\nestado normal\n[E-020]"];
  n5 -> n7 [label="And"];
  h_R11 [label="R-11 · FC 65 %\nla falla está en la fuente de\npoder", fillcolor="#E8F0FE", color="#1F6FEB", shape=note, style="filled"];
  n7 -> h_R11 [label="Then", color="#1F6FEB"];
}