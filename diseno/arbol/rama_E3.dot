  h_R46 [label="R-46 · FC 85 %\nla falla está en la conexión\nfísica o en la alimentación de\nla impresora", fillcolor="#F3E8FD", color="#8E6CEF", shape=note, style="filled"];
  n4 -> h_R46 [label="Then", color="#8E6CEF"];
  n5 [label="responde a la prueba de\ncomunicación de red\n[E-083]"];
  n1 -> n5 [label="And"];
  n6 [label="los trabajos permanecen en\nla cola\n[E-084]"];
  n5 -> n6 [label="And"];
  n7 [label="el servicio de cola de\nimpresión está detenido\n[E-085]"];
