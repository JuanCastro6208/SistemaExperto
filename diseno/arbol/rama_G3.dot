digraph "rama_G3" {
  graph [rankdir=LR, splines=true, nodesep=0.22, ranksep=0.55, fontname="DejaVu Sans", bgcolor="white", pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#5B6676", fontname="DejaVu Sans", fontsize=10, margin="0.10,0.05"];
  edge [color="#8A94A6", fontname="DejaVu Sans", fontsize=8, fontcolor="#5B6676", arrowsize=0.6];
  raiz [label="G3 · No se puede instalar software\n(P-22)", shape=box, style="rounded,filled,bold", fillcolor="#FFF0E0", color="#D9822B", fontsize=11];
  n1 [label="la instalación no se\ncompleta\n[E-132]"];
  raiz -> n1 [label="If"];
  n2 [label="el sistema informa\npermisos insuficientes\n[E-133]"];
  n1 -> n2 [label="And"];
  n3 [label="la cuenta utilizada no\ntiene privilegios de\nadministrador\n[E-134]"];
  n2 -> n3 [label="And"];
  h_R76 [label="R-76 · FC 90 %\nla falla está en los permisos\nde la cuenta", fillcolor="#FFF0E0", color="#D9822B", shape=note, style="filled"];
  n3 -> h_R76 [label="Then", color="#D9822B"];
  n4 [label="el sistema informa un\nbloqueo por política\n[E-135]"];
  n1 -> n4 [label="And"];
  h_R77 [label="R-77 · FC 85 %\nla causa corresponde a una\npolítica de restricción de\nsoftware", fillcolor="#FFF0E0", color="#D9822B", shape=note, style="filled"];
  n4 -> h_R77 [label="Then", color="#D9822B"];
  n5 [label="el espacio libre en la\nunidad del sistema es\ninsuficiente\n[E-136]"];
  n1 -> n5 [label="And"];
  h_R78 [label="R-78 · FC 95 %\nla falla está en el espacio de\nalmacenamiento disponible", fillcolor="#FFF0E0", color="#D9822B", shape=note, style="filled"];
  n5 -> h_R78 [label="Then", color="#D9822B"];
  n6 [label="el archivo de instalación\nno supera la verificación\nde integridad\n[E-137]"];
  n1 -> n6 [label="And"];
  h_R79 [label="R-79 · FC 85 %\nla falla está en el archivo de\ninstalación", fillcolor="#FFF0E0", color="#D9822B", shape=note, style="filled"];
  n6 -> h_R79 [label="Then", color="#D9822B"];
  n7 [label="la instalación sí se\ncompleta con la protección\nsuspendida de forma\ncontrolada\n[E-138]"];
  n1 -> n7 [label="And"];
  h_R80 [label="R-80 · FC 80 %\nla causa corresponde al\nbloqueo de la herramienta de\nprotección", fillcolor="#FFF0E0", color="#D9822B", shape=note, style="filled"];
  n7 -> h_R80 [label="Then", color="#D9822B"];
}