digraph "rama_D2" {
  graph [rankdir=LR, splines=true, nodesep=0.22, ranksep=0.55, fontname="DejaVu Sans", bgcolor="white", pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#5B6676", fontname="DejaVu Sans", fontsize=10, margin="0.10,0.05"];
  edge [color="#8A94A6", fontname="DejaVu Sans", fontsize=8, fontcolor="#5B6676", arrowsize=0.6];
  raiz [label="D2 · Memoria RAM no reconocida\n(P-08)", shape=box, style="rounded,filled,bold", fillcolor="#FCE8E6", color="#C9473D", fontsize=11];
  n1 [label="el equipo emite pitidos al\nencender\n[E-061]"];
  raiz -> n1 [label="If"];
  n2 [label="el equipo arranca al\nretirar uno de los módulos\nde memoria\n[E-062]"];
  n1 -> n2 [label="And"];
  h_R33 [label="R-33 · FC 90 %\nla falla está en el módulo\nretirado", fillcolor="#FCE8E6", color="#C9473D", shape=note, style="filled"];
  n2 -> h_R33 [label="Then", color="#C9473D"];
  n3 [label="el módulo funciona\ncorrectamente en otra\nranura\n[E-063]"];
  n1 -> n3 [label="And"];
  h_R34 [label="R-34 · FC 85 %\nla falla está en la ranura de\nmemoria", fillcolor="#FCE8E6", color="#C9473D", shape=note, style="filled"];
  n3 -> h_R34 [label="Then", color="#C9473D"];
  n4 [label="el sistema reporta menos\nmemoria de la instalada\n[E-064]"];
  raiz -> n4 [label="If"];
  n5 [label="el equipo utiliza video\nintegrado\n[E-065]"];
  n4 -> n5 [label="And"];
  h_R35 [label="R-35 · FC 70 %\nla diferencia corresponde a la\nmemoria reservada por el video", fillcolor="#FCE8E6", color="#C9473D", shape=note, style="filled"];
  n5 -> h_R35 [label="Then", color="#C9473D"];
  n6 [label="el módulo no es reconocido\nen ninguna ranura\n[E-066]"];
  n4 -> n6 [label="And"];
  h_R36 [label="R-36 · FC 85 %\nla falla está en el módulo de\nmemoria", fillcolor="#FCE8E6", color="#C9473D", shape=note, style="filled"];
  n6 -> h_R36 [label="Then", color="#C9473D"];
}