digraph dfd0 {
  graph [fontname="DejaVu Sans", fontsize=20, rankdir=LR, labelloc=t, pad=0.35, dpi=170, nodesep=0.6, ranksep=1.6, splines=spline];
  node  [fontname="DejaVu Sans", fontsize=12];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#2b3a4f", fontcolor="#2b3a4f", arrowsize=0.8];
  label="DFD nivel 0 (diagrama de contexto) · SEDATI\n ";

  solicitante [shape=box, style="filled", fillcolor="#fde9c9", color="#b7791f", penwidth=2, label="Solicitante"];
  admin [shape=box, style="filled", fillcolor="#fde9c9", color="#b7791f", penwidth=2, label="Administrador\n(soporte técnico; carga el\nconocimiento del experto humano)"];
  area [shape=box, style="filled", fillcolor="#fde9c9", color="#b7791f", penwidth=2, label="Área de destino\ndel escalamiento"];
  sis [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" STYLE="ROUNDED" COLOR="#1f6feb" BGCOLOR="#e7f0fe"><TR><TD BGCOLOR="#1f6feb"><FONT COLOR="white"><B>0</B></FONT></TD></TR><TR><TD><B>SEDATI</B><BR/>Sistema experto de diagnóstico<BR/>y atención de incidentes</TD></TR></TABLE>>];

  solicitante -> sis [label="credenciales\nreporte del incidente (equipo, falla)\nsolicitud, cambio o cancelación de cita"];
  sis -> solicitante [label="sesión según el rol\nconsecutivo y estado de sus incidentes\ncitas programadas"];
  admin -> sis [label="credenciales · datos de cuentas\nsíntomas y respuestas graduadas\ndecisión sobre hipótesis · solución aplicada\nhipótesis, evidencias y gránulos If / And / Then"];
  sis -> admin [label="bandeja de incidentes · agenda\npreguntas y su justificación\n5 hipótesis con peso, explicación y acción\nhistorial por equipo, indicadores y reportes\ncontraseñas temporales · auditoría"];
  sis -> area [label="incidente escalado\n(motivo, destino y pruebas realizadas)"];
  {rank=same; solicitante; admin;}
}
